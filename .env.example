# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Channel (username with @ or channel ID)
# Example: @my_channel or -1001234567890
TELEGRAM_CHANNEL=@your_channel_username

# Trading pair (default: QUAIUSDT)
SYMBOL=QUAIUSDT

# Price change threshold for UP notification (default: 4.0)
THRESHOLD_UP=4.0

# Price change threshold for DOWN notification (default: 4.0)
THRESHOLD_DOWN=4.0

# Time period in minutes to monitor (default: 5)
LOOKBACK_MINUTES=5

# Alert when price moves by this absolute step from the last step-anchor
# Examples: 0.01 or 0.1  |  leave empty to disable
PRICE_STEP=0.01

# Alert when price reaches/crosses these exact levels (comma-separated)
# Example: 0.03,0.05,0.1  |  leave empty to disable
TARGET_PRICES=0.03,0.05,0.1
